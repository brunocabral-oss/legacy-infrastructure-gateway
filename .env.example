# Legacy Infrastructure Gateway (LIG) Environment Configuration Example
# Copy this file to .env and adjust variables for your environment.
# NEVER commit real credentials to version control.

# Application Settings
LIG_ENVIRONMENT=development
LIG_LOG_LEVEL=INFO
LIG_DEBUG=false
LIG_HOST=0.0.0.0
LIG_PORT=8000

# Security & Policies
LIG_READ_ONLY_MODE=true
LIG_RAW_COMMANDS_ENABLED=false
LIG_CONFIGURATION_CHANGES_ENABLED=false
LIG_DEFAULT_POLICY=deny
LIG_GLOBAL_TIMEOUT_SECONDS=30
LIG_DEVICE_CONCURRENCY_LIMIT=3

# Database (PostgreSQL)
POSTGRES_USER=lig_admin
POSTGRES_PASSWORD=mock_db_password_change_me
POSTGRES_DB=lig_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://lig_admin:mock_db_password_change_me@postgres:5432/lig_db

# Mock Driver
LIG_ENABLE_MOCK_DRIVER=true
